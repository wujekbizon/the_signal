<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Signal</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="terminal-frame">
        <header class="terminal-header">
            <div class="terminal-title">The Signal</div>
            <div class="terminal-status">
                <span class="status-indicator">SYSTEM ONLINE</span>
                <span id="clock">--:--:--</span>
            </div>
        </header>

        <div class="terminal-main">
            @if (ViewData["HideNavigation"] == null)
            {
                <nav class="terminal-nav">
                    <div class="nav-section">
                        <div class="nav-section-title">Main</div>
                        <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                           asp-controller="Home" asp-action="Index">
                            Terminal
                        </a>
                        <a class="nav-item" href="#">Character</a>
                        <a class="nav-item" href="#">Inventory</a>
                        <a class="nav-item" href="#">Quests</a>
                    </div>
                    
                    <div class="nav-section">
                        <div class="nav-section-title">System</div>
                        <a class="nav-item" href="#" onclick="openSettings(); return false;">Settings</a>
                        <a class="nav-item" href="#">Logs</a>
                    </div>
                </nav>
            }
            <main class="terminal-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Settings Modal -->
    <div id="settingsModal" class="settings-modal">
        <div class="settings-panel">
            <div class="settings-title">/// AUDIO SETTINGS</div>
            
            <div class="setting-row">
                <span class="setting-label">Master Volume</span>
                <div class="setting-control">
                    <input type="range" id="masterVolume" class="volume-slider" min="0" max="100" value="30">
                    <span class="volume-value" id="masterValue">30%</span>
                </div>
            </div>
            
            <div class="setting-row">
                <span class="setting-label">Music Volume</span>
                <div class="setting-control">
                    <input type="range" id="musicVolume" class="volume-slider" min="0" max="100" value="70">
                    <span class="volume-value" id="musicValue">70%</span>
                </div>
            </div>
            
            <div class="setting-row">
                <span class="setting-label">SFX Volume</span>
                <div class="setting-control">
                    <input type="range" id="sfxVolume" class="volume-slider" min="0" max="100" value="80">
                    <span class="volume-value" id="sfxValue">80%</span>
                </div>
            </div>
            
            <div class="setting-row">
                <span class="setting-label">Mute All</span>
                <div class="setting-control">
                    <button id="muteBtn" class="mute-btn" onclick="toggleMute()">OFF</button>
                </div>
            </div>
            
            <button class="close-settings" onclick="closeSettings()">Close</button>
        </div>
    </div>

    <script>
        function updateClock() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', { hour12: false });
            document.getElementById('clock').textContent = timeString;
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>

    <script src="~/js/audioManager.js" asp-append-version="true"></script>
    <script src="~/js/settings.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
